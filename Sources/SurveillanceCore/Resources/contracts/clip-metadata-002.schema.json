{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zero-State-LLC/SS-specs/contracts/clip-metadata-002.schema.json",
  "title": "Exact-duration clip metadata \u2014 migration target, not active delivery",
  "$comment": "Parallel frame count, checked arithmetic and clip semantics require the semantic validator. Active versions.json remains v1 until coordinated runtime migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "animationVersion",
    "clips"
  ],
  "properties": {
    "schemaVersion": {
      "const": "clip-metadata-002"
    },
    "animationVersion": {
      "const": "animation-civic-seam-001"
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clipId",
          "actorRole",
          "state",
          "authoritativeEventMarker",
          "blendOrTransition",
          "reducedMotionClip",
          "audioCue",
          "vfxCue",
          "directions",
          "frameIds",
          "loop",
          "anchor",
          "cancelWindows",
          "timing"
        ],
        "properties": {
          "clipId": {
            "type": "string",
            "minLength": 1
          },
          "actorRole": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "authoritativeEventMarker": {
            "type": "string",
            "minLength": 1
          },
          "blendOrTransition": {
            "type": "string",
            "minLength": 1
          },
          "reducedMotionClip": {
            "type": "string",
            "minLength": 1
          },
          "audioCue": {
            "type": "string",
            "minLength": 1
          },
          "vfxCue": {
            "type": "string",
            "minLength": 1
          },
          "directions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "n",
                "e",
                "s",
                "w"
              ]
            }
          },
          "frameIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "loop": {
            "type": "boolean"
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "y": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              }
            }
          },
          "cancelWindows": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unitsPerSecond",
              "frameUnits"
            ],
            "properties": {
              "unitsPerSecond": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "frameUnits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                }
              }
            }
          }
        }
      }
    }
  }
}
